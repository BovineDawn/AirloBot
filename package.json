{
  "name": "airlobot",
  "productName": "AirloBot",
  "version": "0.8.1",
  "private": true,
  "description": "A standalone, private local assistant with project conversations and reviewed file tools.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:agents": "node scripts/agent-live-test.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "runtime:install": "node scripts/install-runtime.mjs",
    "test:standalone": "node scripts/standalone-live-test.mjs",
    "test:project-build": "node scripts/project-build-live-test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "vite": "8.3.5",
    "@electron/packager": "^19.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BovineDawn/AirloBot.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
